# ========================================================
# Azumi Movie Reviews - Uploads Directory Protection
# Compatible with Apache 2.2, 2.4, and PHP-FPM / FastCGI
# ========================================================

# Disable execution of scripts and executable binaries
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|py|exe|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory indexing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>
